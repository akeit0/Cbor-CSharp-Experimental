<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);CBOR_NETSTANDARD21</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Cbor.SourceGenerator/Cbor.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Keep the legacy netstandard2.1 asset covered when net8 selects its dedicated asset. -->
    <ProjectReference Include="../../src/Cbor/Cbor.csproj" SetTargetFramework="TargetFramework=netstandard2.1" SkipGetTargetFrameworkProperties="true" />
    <Compile Include="../Shared/IntegerHarness.cs" Link="IntegerHarness.cs" />
    <Compile Include="../Cbor.Tests/TypedSerializationTests.cs" Link="TypedSerializationTests.cs" />
    <Compile Include="../Cbor.Tests/RuntimeImprovementTests.cs" Link="RuntimeImprovementTests.cs" />
    <Compile Include="../Cbor.Tests/OperationResolutionTests.cs" Link="OperationResolutionTests.cs" />
    <Compile Include="../Cbor.Tests/WireValueTests.cs" Link="WireValueTests.cs" />
    <Compile Include="../Cbor.Tests/TestFactories.cs" Link="TestFactories.cs" />
    <Compile Include="../Cbor.Tests/FactoryTests.cs" Link="FactoryTests.cs" />
    <Compile Include="../Cbor.Tests/GenericInheritanceTests.cs" Link="GenericInheritanceTests.cs" />
    <Compile Include="../../eng/PackageConsumer/SampleModels.cs" Link="SampleModels.cs" />
    <Compile Include="../Cbor.Tests/KeyComparerTests.cs" Link="KeyComparerTests.cs" />
    <Compile Include="../Cbor.Tests/BufferTierTests.cs" Link="BufferTierTests.cs" />
    <Compile Include="../Cbor.Tests/PrimitiveTests.cs" Link="PrimitiveTests.cs" />
    <Compile Include="../Cbor.Tests/StructuralValidationTests.cs" Link="StructuralValidationTests.cs" />
    <Compile Include="../Cbor.Tests/WriterReaderTests.cs" Link="WriterReaderTests.cs" />
  </ItemGroup>
</Project>
